                         "@fontsource/jetbrains-mono":  "^5.3.0",
                         "@fontsource/manrope":  "^5.3.0",
                         "@fontsource/source-sans-3":  "^5.3.1",
                         "@prisma/client":  "5.13.0",
                         "busboy":  "^1.6.0",
                         "dotenv":  "^18.0.10",
                         "express":  "^5.3.0",
                         "fflate":  "^0.8.3",
                         "jose":  "^6.2.17",
                         "papaparse":  "^5.7.0",
                         "react":  "^19.3.1",
                         "react-dom":  "^19.3.1",
                         "react-router-dom":  "^7.18.5"
                     },
    "devDependencies":  {
