# Insightx server configuration.
# Copy this file to .env for local development and fill values through your
# secure secret store. .env is gitignored. Never expose these values to the
# client, prefix them with VITE_, or commit them.

# Public origin where the built app is served. OAuth callback URLs derive from
# this value. Local development defaults to http://localhost:5180 when unset.
APP_ORIGIN=http://localhost:5180
PORT=3001

# Required for OAuth. Use at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Session cookie settings. Secure defaults to true in production and for HTTPS
# origins. Set false only for plain-HTTP local development.
COOKIE_SECURE=false
# lax (default), strict, or none. Use none only with HTTPS and secure cookies.
COOKIE_SAMESITE=lax
# Optional cookie domain for a parent domain such as example.com.
COOKIE_DOMAIN=
# Optional CHIPS flag for third-party embedded previews. Requires HTTPS.
COOKIE_PARTITIONED=false
# Comma-separated HTTPS origins allowed to frame the app (CSP frame-ancestors).
EMBED_ALLOW_ORIGINS=

# Serve the production build from the auth server. Set false when using Vite.
SERVE_STATIC=true
TRUST_PROXY=false

# Google OAuth client. Authorized callback URL:
# ${APP_ORIGIN}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# GitHub OAuth app. Authorization callback URL:
# ${APP_ORIGIN}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Optional extra frontend origins allowed to call the API with credentials
# (comma-separated), in addition to APP_ORIGIN.
CORS_ALLOWED_ORIGINS=
