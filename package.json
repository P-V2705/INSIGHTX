                    "dev:web":  "vite",
                    "dev:server":  "node --env-file-if-exists=.env server/index.js",
                    "build":  "vite build",
                    "start":  "node --env-file-if-exists=.env server/index.js",
                    "preview":  "node --env-file-if-exists=.env server/index.js",
                    "postinstall":  "prisma generate"
                },
    "engines":  {
                    "node":  "\u003e=22.9"
                },
